DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Comma-separated. The PUBLIC_BASE_URL host is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default. For Postgres:
# DATABASE_URL=postgres://omni:omni@localhost:5432/omni
# Public HTTPS URL of this backend (webhooks + OAuth callbacks). Use ngrok/cloudflared locally.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
POLL_INTERVAL_SECONDS=30
# --- Security (production) ---
# DJANGO_DEBUG=false requires a real DJANGO_SECRET_KEY and FIELD_ENCRYPTION_KEY, and turns on
# HTTPS redirects, secure cookies and HSTS.
# Change the admin path so /admin/ isn't exposed on your public URL:
ADMIN_URL=admin/
# Only for self-hosted setups whose mail server is on a private network (disables SSRF guard):
ALLOW_PRIVATE_HOSTS=false
# Rate limits
THROTTLE_AUTH=20/min
THROTTLE_SEND=60/min
THROTTLE_USER=1200/min
# --- Payments (leave a key empty to hide that method on the Billing page) ---
# Khalti ePayment v2: secret key from test-admin.khalti.com (sandbox) or admin.khalti.com (live)
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# eSewa ePay v2: sandbox defaults (EPAYTEST) are used automatically when DJANGO_DEBUG=true
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Live: https://epay.esewa.com.np/api/epay/main/v2/form  and  https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://uat.esewa.com.np/api/epay/transaction/status/
# Stripe (cards, USD): secret key + webhook secret for <PUBLIC_BASE_URL>/api/billing/webhook/stripe/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Email for team invites (optional: without it, invite links are shown to copy) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OmniInbox <no-reply@yourdomain.com>

# --- Social publishing (Publish page) ---
# Facebook + Instagram use a System User token pasted in the app (no extra keys needed).
# Uploaded photos/videos are stored here and fetched by Meta through signed PUBLIC_BASE_URL links.
# MEDIA_ROOT=/var/lib/omniinbox/media   (default: backend/media)
# YouTube: Google Cloud OAuth client (Web). Enable "YouTube Data API v3".
# Redirect URI: <PUBLIC_BASE_URL>/api/publishing/oauth/youtube/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: developers.tiktok.com app with Login Kit + Content Posting API (Direct Post), scopes user.info.basic,video.publish
# Redirect URI: <PUBLIC_BASE_URL>/api/publishing/oauth/tiktok/callback/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AI (AI & Automations page, inbox suggestions, Publish captions) ---
# One OpenRouter key gives access to GPT-4o and other models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (e.g. openai/gpt-4o-mini is ~15x cheaper)
OPENROUTER_MODEL=openai/gpt-4o

# --- Web push notifications (phones/desktops) ---
# Contact address sent to browser push services (required by the Web Push standard).
PUSH_CONTACT_EMAIL=support@example.com

# --- Rate limits behind proxies ---
# How many proxies in front of Django add the visitor's IP to X-Forwarded-For (e.g. nginx or Cloudflare in front of Next.js = 1).
# Used to rate-limit the public website chat and login per visitor. 0 = use the direct connection address.
TRUSTED_PROXIES=1

# --- One-click "Connect with Facebook" for WhatsApp, Messenger and Instagram ---
# Your OmniInbox Meta app (developers.facebook.com). See the help article "Set up Connect with Facebook".
# In the Meta app, set ONE webhook for everyone: <PUBLIC_BASE_URL>/api/webhooks/meta/ with META_VERIFY_TOKEN.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Facebook Login for Business configuration IDs: WhatsApp Embedded Signup, and Pages + Instagram messaging
META_WA_CONFIG_ID=
META_PAGES_CONFIG_ID=
# Optional: configuration for Publish (pages_show_list, pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish). Empty = use META_PAGES_CONFIG_ID (then add those permissions to it).
META_PUBLISH_CONFIG_ID=

# --- Shared cache (needed in production for instant updates across processes) ---
# REDIS_URL=redis://localhost:6379/0

# --- Photos, files and voice notes in conversations ---
ATTACHMENT_MAX_MB=25

# --- Affiliate program (recurring commissions; manage affiliates in Admin -> Affiliates) ---
AFFILIATE_COMMISSION_RATE=0.20
AFFILIATE_HOLD_DAYS=14
AFFILIATE_MIN_PAYOUT_NPR=2000
AFFILIATE_MIN_PAYOUT_USD=15

# Platform admin dashboard: estimated AI cost (USD per 1M tokens, blended input+output for your OpenRouter model)
AI_COST_PER_MILLION_TOKENS_USD=4

# AI knowledge base: search by meaning (embeddings via the same OpenRouter key). false = keyword search only
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
# Voice notes (transcription) and photos (payment screenshots) need a model that accepts audio / images.
# Gemini Flash understands Nepali speech well and is cheap. Any OpenRouter model with audio/image input works.
AI_AUDIO_MODEL=google/gemini-2.5-flash
AI_VISION_MODEL=google/gemini-2.5-flash
